# Canonical production URL, used only to resolve social-preview (OG/Twitter)
# image links in layout.tsx. Optional — Vercel's own VERCEL_URL covers this
# automatically on any deploy, set this only once you're on a custom domain.
NEXT_PUBLIC_SITE_URL=

# --- Auth (src/app/api/auth/, src/lib/server/) ---
# Same-origin Next.js API routes handling signup/login/logout/me.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=subtitle_studio
JWT_SECRET=change-this-to-a-long-random-string
# Set to true once the site is served over https in production.
COOKIE_SECURE=false

# Speech-to-text provider. STTProvider (src/lib/stt/provider.ts) exists so
# more can be added without touching the API route or pipeline.
#   elevenlabs       -> ElevenLabs Scribe v2 (HTTP, word timestamps, default —
#                        handles both English and Hindi with one API key)
#   openai-whisper   -> OpenAI Whisper API (HTTP, word timestamps via verbose_json)
#   nvidia-parakeet  -> NVIDIA Riva Parakeet-TDT (gRPC only; see below)
STT_PROVIDER=elevenlabs

# --- elevenlabs (default) ---
# Server-side only — never exposed to the browser. Get your key from
# elevenlabs.io -> Profile -> API Keys. Handles English and Hindi
# transcription (language_code is set automatically per-request based on the
# subtitle language chosen in the UI); Hinglish transliterates the Hindi
# output afterward using Gemini (see GEMINI_API_KEY below).
ELEVENLABS_API_KEY=

# --- openai-whisper ---
# Server-side only — never exposed to the browser (the client only ever
# talks to /api/transcribe).
OPENAI_API_KEY=
# Optional. Defaults to "whisper-1", the model verified to return
# per-word timestamps via response_format=verbose_json.
OPENAI_STT_MODEL=whisper-1

# --- nvidia-parakeet ---
# Word-level timestamps for Parakeet models are only exposed via NVIDIA's
# gRPC API, not their HTTP REST endpoint, so this provider shells out to
# scripts/nvidia_transcribe.py (built on NVIDIA's own nvidia-riva-client
# package). Requires Python 3 on PATH with that package installed:
#   pip install -U nvidia-riva-client
# Get NVIDIA_API_KEY and NVIDIA_FUNCTION_ID from the model's page on
# build.nvidia.com (Get API Key) — the function-id appears in the gRPC
# --metadata example on that page.
NVIDIA_API_KEY=
NVIDIA_FUNCTION_ID=
# Optional, defaults to en-US. BCP-47 code matching your audio.
NVIDIA_LANGUAGE_CODE=en-US

# --- Hindi / Hinglish fallback ASR (src/lib/stt/index.ts + transliterate.ts) ---
# Only used when STT_PROVIDER is NOT "elevenlabs" (ElevenLabs handles Hindi
# itself — see above). "Hindi" transcribes directly with this model.
# "Hinglish" transcribes with this same model, then transliterates the Hindi
# text word-for-word into Roman script using GEMINI_API_KEY below — it
# does not use a separate ASR model. Get NVIDIA_HINDI_API_KEY /
# NVIDIA_HINDI_FUNCTION_ID the same way as NVIDIA_API_KEY above, but from the
# nvidia/parakeet-1.1b-rnnt-multilingual-asr model page on build.nvidia.com.
NVIDIA_HINDI_API_KEY=
NVIDIA_HINDI_FUNCTION_ID=

# --- Hindi -> Hinglish transliteration (src/lib/stt/transliterate.ts) ---
# Used only for the Hinglish subtitle language, regardless of which
# STT_PROVIDER transcribed the Hindi audio: takes the Hindi (Devanagari)
# words and transliterates them word-for-word into Roman-script "Hinglish"
# (e.g. "क्या" -> "kya"). This is a text task, not audio, so it's a plain
# LLM call — Gemini Flash, not NVIDIA. Get a key from aistudio.google.com/apikey.
GEMINI_API_KEY=
